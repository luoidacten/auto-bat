{
  "name": "legacy-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Legacy Arena: direct control, offline bots and WebRTC P2P with automatically selected worker host.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "dev": "node tools/build.cjs && node server/main.mjs",
    "start": "node tools/build.cjs && node server/main.mjs",
    "test": "node tools/compile.cjs && node --test tests/*.test.mjs tools/build.test.cjs",
    "check:roster": "node tools/compare-roster.cjs",
    "test:browser": "node tools/build.cjs && node tools/rtc-test.cjs",
    "test:static": "python3 tools/static-smoke.py"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "acorn": "8.19.0"
  }
}
